---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Badge from './Badge.astro';
import CubeMark from './CubeMark.astro';
import { toLang, useTranslations, assetHref, localizedContent } from '../i18n/utils';

interface Props {
  asset: CollectionEntry<'assets'>;
}
const { asset } = Astro.props;
const d = asset.data;
const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const l = localizedContent(d, lang);
const href = assetHref(lang, asset.id);

// Petites pastilles de contenu (seulement si vrai)
const flags = [
  d.playableDemoUrl && t('badge.playableDemo'),
  d.youtube && t('badge.video'),
  d.demoMapIncluded && t('badge.demoMap'),
].filter(Boolean) as string[];

const price = d.pricePersonal;
---

<a
  href={href}
  class="card-hover group relative flex flex-col overflow-hidden rounded-[--radius-card] border border-border bg-surface"
>
  <!-- Média : image de couverture OU placeholder de marque -->
  <div class="relative aspect-[16/10] overflow-hidden bg-surface-2">
    {
      d.cover ? (
        <Image
          src={d.cover}
          alt={l.title}
          widths={[400, 640, 800]}
          sizes="(max-width: 640px) 100vw, 380px"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-surface-2 via-surface to-elevated">
          <div class="iso-grid absolute inset-0 opacity-40" />
          <CubeMark class="relative h-16 w-16 opacity-90 transition-transform duration-500 group-hover:scale-110" />
        </div>
      )
    }

    {
      d.category && (
        <div class="absolute left-3 top-3">
          <Badge variant="outline" class="bg-bg/70 backdrop-blur-sm">{d.category}</Badge>
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-display text-lg font-semibold text-text">{l.title}</h3>
    <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-text-muted">{l.tagline}</p>

    {
      flags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {flags.map((f) => (
            <Badge variant="accent">{f}</Badge>
          ))}
        </div>
      )
    }

    <div class="mt-5 flex items-center justify-between border-t border-border/60 pt-4">
      <span class="text-sm font-medium text-text">
        {price ? <span class="tabular">{price}</span> : <span class="text-text-muted">{t('card.viewOnFab')}</span>}
      </span>
      <span class="inline-flex items-center gap-1 text-sm font-semibold text-accent-bright">
        {t('card.details')}
        <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>
  </div>
</a>
