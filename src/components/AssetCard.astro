---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import CubeMark from './CubeMark.astro';
import { toLang, useTranslations, assetHref, localizedContent } from '../i18n/utils';

interface Props {
  asset: CollectionEntry<'assets'>;
}
const { asset } = Astro.props;
const d = asset.data;
const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const l = localizedContent(d, lang);
const href = assetHref(lang, asset.id);

// Petites mentions sous le titre (seulement si vrai)
const flags = [
  (d.playableDemoUrl || d.demoDownloadUrl) && t('badge.playableDemo'),
  d.youtube && t('badge.video'),
  d.demoMapIncluded && t('badge.demoMap'),
].filter(Boolean) as string[];

const price = d.pricePersonal;
---

<a href={href} class="group block">
  <!-- Vignette : l'image domine, texte en dessous sur le fond de page -->
  <div class="relative aspect-video overflow-hidden rounded-lg bg-surface-2">
    {
      d.cover ? (
        <Image
          src={d.cover}
          alt={l.title}
          widths={[400, 640, 800]}
          sizes="(max-width: 640px) 100vw, 380px"
          class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center">
          <CubeMark class="h-14 w-14 opacity-80" />
        </div>
      )
    }
  </div>

  <div class="mt-2.5">
    <h3 class="font-display text-sm font-semibold leading-snug text-text transition-colors group-hover:text-accent-bright">
      {l.title}
    </h3>
    <p class="mt-0.5 line-clamp-1 text-xs text-text-muted">{l.tagline}</p>
    <div class="mt-1.5 flex flex-wrap items-center gap-x-1.5 gap-y-0.5 text-xs text-text-faint">
      {d.category && <span>{d.category}</span>}
      {
        flags.map((f) => (
          <>
            <span aria-hidden="true" class="text-text-faint/50">·</span>
            <span>{f}</span>
          </>
        ))
      }
    </div>
    <div class="tabular mt-1 text-xs text-text">
      {price ? price : <span class="text-text-faint">{t('card.viewOnFab')}</span>}
    </div>
  </div>
</a>
