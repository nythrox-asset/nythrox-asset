---
import type { CollectionEntry } from 'astro:content';
import Badge from './Badge.astro';
import { toLang, useTranslations } from '../i18n/utils';

interface Props {
  data: CollectionEntry<'assets'>['data'];
}
const { data: d } = Astro.props;
const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

const included = [
  d.demoMapIncluded && t('buy.demoMapIncluded'),
  d.overviewMapIncluded && t('buy.overviewMapIncluded'),
].filter(Boolean) as string[];
---

<div class="rounded-[--radius-card] border border-border bg-surface p-6">
  {
    (d.pricePersonal || d.pricePro) && (
      <div class="mb-5 flex flex-wrap items-end gap-x-6 gap-y-2">
        {d.pricePersonal && (
          <div>
            <div class="text-xs uppercase tracking-wider text-text-faint">{t('buy.personal')}</div>
            <div class="font-display text-2xl font-bold tabular text-text">{d.pricePersonal}</div>
          </div>
        )}
        {d.pricePro && (
          <div>
            <div class="text-xs uppercase tracking-wider text-text-faint">{t('buy.professional')}</div>
            <div class="font-display text-2xl font-bold tabular text-text">{d.pricePro}</div>
          </div>
        )}
      </div>
    )
  }

  {
    d.fabUrl ? (
      <a
        href={d.fabUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-5 py-3.5 font-semibold text-white transition-colors hover:bg-accent-deep"
      >
        {t('buy.getItOnFab')}
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    ) : (
      <div class="flex w-full items-center justify-center gap-2 rounded-xl border border-dashed border-border-strong px-5 py-3.5 font-semibold text-text-muted">
        {t('buy.comingSoonFab')}
      </div>
    )
  }

  {
    d.playableDemoUrl && (
      <a
        href={d.playableDemoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 flex w-full items-center justify-center gap-2 rounded-xl border border-border-strong bg-surface-2 px-5 py-3 font-semibold text-text transition-colors hover:border-accent/50"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4 text-accent-bright" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
        {t('buy.playDemo')}
      </a>
    )
  }

  {d.license && <p class="mt-4 text-center text-xs text-text-faint">{d.license}</p>}

  {
    included.length > 0 && (
      <div class="mt-5 flex flex-wrap justify-center gap-2 border-t border-border/60 pt-5">
        {included.map((x) => (
          <Badge variant="accent">{x}</Badge>
        ))}
      </div>
    )
  }
</div>
