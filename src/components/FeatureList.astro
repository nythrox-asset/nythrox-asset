---
interface Props {
  features: string[];
}
const { features } = Astro.props;
---

{
  features.length > 0 && (
    <ul class="grid gap-3 sm:grid-cols-2">
      {features.map((f) => (
        <li class="flex items-start gap-3 rounded-xl border border-border/70 bg-surface/60 px-4 py-3">
          <svg
            viewBox="0 0 24 24"
            class="mt-0.5 h-4 w-4 shrink-0 text-accent-bright"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            aria-hidden="true"
          >
            <path d="m5 12 4.5 4.5L19 7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="text-sm leading-relaxed text-text">{f}</span>
        </li>
      ))}
    </ul>
  )
}
