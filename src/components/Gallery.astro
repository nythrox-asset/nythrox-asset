---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { toLang, useTranslations } from '../i18n/utils';

interface Props {
  images: ImageMetadata[];
  title: string;
}
const { images, title } = Astro.props;
const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
---

{
  images.length > 0 && (
    <div>
      <div
        class="grid grid-cols-2 gap-3 sm:grid-cols-3"
        data-gallery
      >
        {images.map((img, i) => (
          <button
            type="button"
            class="card-hover group relative aspect-video overflow-hidden rounded-md border border-border bg-surface-2"
            data-index={i}
            data-full={img.src}
            aria-label={t('gallery.open', { i: i + 1, n: images.length })}
          >
            <Image
              src={img}
              alt={`${title}, screenshot ${i + 1}`}
              widths={[320, 480]}
              sizes="(max-width: 640px) 50vw, 300px"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </button>
        ))}
      </div>

      {/* Lightbox */}
      <div
        data-lightbox
        class="fixed inset-0 z-50 hidden items-center justify-center bg-bg/90 p-4 backdrop-blur-sm"
        role="dialog"
        aria-modal="true"
        aria-label={t('gallery.dialog', { title })}
      >
        <button
          type="button"
          data-lb-close
          class="absolute right-4 top-4 flex h-11 w-11 items-center justify-center rounded-full border border-border-strong bg-surface text-text transition-colors hover:bg-surface-2"
          aria-label={t('gallery.close')}
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 6l12 12M18 6 6 18" stroke-linecap="round" /></svg>
        </button>
        <button
          type="button"
          data-lb-prev
          class="absolute left-4 flex h-11 w-11 items-center justify-center rounded-full border border-border-strong bg-surface text-text transition-colors hover:bg-surface-2"
          aria-label={t('gallery.prev')}
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <img data-lb-img src="" alt="" class="max-h-[85vh] max-w-full rounded-lg object-contain" />
        <button
          type="button"
          data-lb-next
          class="absolute right-4 bottom-4 flex h-11 w-11 items-center justify-center rounded-full border border-border-strong bg-surface text-text transition-colors hover:bg-surface-2 sm:bottom-auto"
          aria-label={t('gallery.next')}
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((grid) => {
    const wrap = grid.parentElement!;
    const lb = wrap.querySelector<HTMLElement>('[data-lightbox]');
    if (!lb) return;
    const img = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const btns = Array.from(grid.querySelectorAll<HTMLElement>('button[data-full]'));
    const sources = btns.map((b) => b.dataset.full!);
    let current = 0;

    const show = (i: number) => {
      current = (i + sources.length) % sources.length;
      img.src = sources[current];
    };
    const open = (i: number) => {
      show(i);
      lb.classList.remove('hidden');
      lb.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lb.classList.add('hidden');
      lb.classList.remove('flex');
      document.body.style.overflow = '';
    };

    btns.forEach((b, i) => b.addEventListener('click', () => open(i)));
    lb.querySelector('[data-lb-close]')?.addEventListener('click', close);
    lb.querySelector('[data-lb-next]')?.addEventListener('click', () => show(current + 1));
    lb.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(current - 1));
    lb.addEventListener('click', (e) => {
      if (e.target === lb) close();
    });
    document.addEventListener('keydown', (e) => {
      if (lb.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'ArrowLeft') show(current - 1);
    });
  });
</script>
