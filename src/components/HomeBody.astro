---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import AssetCard from './AssetCard.astro';
import CubeMark from './CubeMark.astro';
import TrustStrip from './TrustStrip.astro';
import { toLang, useTranslations, homeHref, assetHref, localizedContent } from '../i18n/utils';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const home = homeHref(lang);

const all = (await getCollection('assets'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => {
    if (b.data.order !== a.data.order) return b.data.order - a.data.order;
    const bd = b.data.date?.getTime() ?? 0;
    const ad = a.data.date?.getTime() ?? 0;
    return bd - ad;
  });

/* Bannière : image dédiée `banner`, sinon 1re capture de galerie.
   Jamais la cover (souvent typographiée, elle rend mal recadrée). */
const bannerImage = (a: (typeof all)[number]) =>
  a.data.banner ?? a.data.gallery[0] ?? a.data.cover;

const heroes = all
  .filter((a) => a.data.featured && bannerImage(a))
  .map((a) => ({
    id: a.id,
    href: assetHref(lang, a.id),
    l: localizedContent(a.data, lang),
    meta: [a.data.category, a.data.engine].filter(Boolean).join(' · '),
    img: bannerImage(a)!,
    demo: a.data.demoDownloadUrl,
  }));

const count = all.length;
const countLabel =
  count > 0 ? t(count === 1 ? 'assets.countOne' : 'assets.countMany', { n: count }) : t('assets.comingSoon');
---

<Base>
  {
    heroes.length > 0 && (
      <!-- CARROUSEL VEDETTE -->
      <section class="mx-auto max-w-6xl px-5 pt-5 sm:px-8">
        <div data-carousel class="group relative h-[300px] overflow-hidden rounded-xl bg-surface-2 sm:h-[380px]">
          {heroes.map((h, i) => (
            <div
              data-slide
              class:list={[
                'absolute inset-0 transition-opacity duration-500',
                i === 0 ? 'opacity-100' : 'pointer-events-none opacity-0',
              ]}
            >
              <Image
                src={h.img}
                alt={h.l.title}
                widths={[768, 1280, 1920]}
                sizes="(max-width: 1024px) 100vw, 1152px"
                class="h-full w-full object-cover"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
              <div class="absolute inset-0 bg-gradient-to-r from-bg/85 via-bg/40 to-transparent" />
              <div class="absolute inset-0 flex max-w-xl flex-col justify-center gap-2.5 p-6 sm:p-10">
                {h.meta && (
                  <span class="text-xs font-medium uppercase tracking-wider text-white/70">{h.meta}</span>
                )}
                <h2 class="text-2xl font-bold leading-tight text-white sm:text-[32px]">
                  <a href={h.href} class="hover:underline">{h.l.title}</a>
                </h2>
                <p class="line-clamp-2 max-w-md text-sm leading-relaxed text-white/85">{h.l.tagline}</p>
                <div class="mt-3 flex flex-wrap items-center gap-2.5">
                  {h.demo ? (
                    <a
                      href={h.demo}
                      download
                      class="inline-flex h-10 items-center gap-2 rounded-lg bg-accent px-4 text-sm font-medium text-white transition-colors hover:bg-accent-deep"
                    >
                      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                        <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      {t('buy.downloadDemo')}
                    </a>
                  ) : (
                    <a
                      href={h.href}
                      class="inline-flex h-10 items-center gap-2 rounded-lg bg-accent px-4 text-sm font-medium text-white transition-colors hover:bg-accent-deep"
                    >
                      {t('card.details')}
                    </a>
                  )}
                  {h.demo && (
                    <a
                      href={h.href}
                      class="inline-flex h-10 items-center rounded-lg px-4 text-sm font-medium text-white transition-colors hover:bg-white/20"
                      style="background-color: rgba(255,255,255,0.15);"
                    >
                      {t('card.details')}
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))}

          {heroes.length > 1 && (
            <>
              <button
                type="button"
                data-prev
                aria-label={t('gallery.prev')}
                class="absolute left-3 top-1/2 z-10 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-bg/70 text-text opacity-0 backdrop-blur-sm transition-opacity hover:bg-bg/90 focus-visible:opacity-100 group-hover:opacity-100"
              >
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
              <button
                type="button"
                data-next
                aria-label={t('gallery.next')}
                class="absolute right-3 top-1/2 z-10 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-bg/70 text-text opacity-0 backdrop-blur-sm transition-opacity hover:bg-bg/90 focus-visible:opacity-100 group-hover:opacity-100"
              >
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
              <div class="absolute bottom-3 left-1/2 z-10 flex -translate-x-1/2 gap-1.5">
                {heroes.map((h, i) => (
                  <button
                    type="button"
                    data-dot
                    aria-label={t('gallery.open', { i: i + 1, n: heroes.length })}
                    class:list={[
                      'h-1.5 rounded-full transition-all',
                      i === 0 ? 'w-5 bg-white' : 'w-1.5 bg-white/40 hover:bg-white/70',
                    ]}
                  />
                ))}
              </div>
            </>
          )}
        </div>

        <p class="mt-4 max-w-2xl text-[13px] leading-relaxed text-text-muted">{t('hero.subtitle')}</p>
        <TrustStrip />
      </section>
    )
  }

  <!-- TOUS LES ASSETS -->
  <section id="assets" class="mx-auto max-w-6xl scroll-mt-20 px-5 pt-12 sm:px-8">
    <div class="mb-5 flex items-baseline justify-between">
      <h2 class="text-2xl font-bold text-text">{t('assets.heading')}</h2>
      <span class="text-xs text-text-faint">{countLabel}</span>
    </div>

    {
      all.length > 0 ? (
        <div class="grid grid-cols-2 gap-5 lg:grid-cols-3">
          {all.map((a) => (
            <AssetCard asset={a} />
          ))}
        </div>
      ) : (
        <div class="flex flex-col items-center rounded-lg border border-dashed border-border-strong bg-surface px-6 py-20 text-center">
          <CubeMark class="h-14 w-14 opacity-60" />
          <p class="mt-6 font-display text-lg font-semibold text-text">{t('assets.emptyTitle')}</p>
          <p class="mt-2 max-w-sm text-sm text-text-muted">
            {t('assets.emptyPre')}
            <code class="rounded bg-surface-2 px-1.5 py-0.5 text-accent-bright">src/content/assets/</code>
            {t('assets.emptyPost')}
          </p>
        </div>
      )
    }
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    if (slides.length < 2) return;
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const show = (n: number) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((s, k) => {
        s.classList.toggle('opacity-100', k === current);
        s.classList.toggle('opacity-0', k !== current);
        s.classList.toggle('pointer-events-none', k !== current);
      });
      dots.forEach((d, k) => {
        d.classList.toggle('w-5', k === current);
        d.classList.toggle('bg-white', k === current);
        d.classList.toggle('w-1.5', k !== current);
        d.classList.toggle('bg-white/40', k !== current);
      });
    };

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const start = () => {
      if (!reduced && !timer) timer = setInterval(() => show(current + 1), 6000);
    };
    const stop = () => {
      if (timer) { clearInterval(timer); timer = undefined; }
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => { show(current - 1); stop(); start(); });
    root.querySelector('[data-next]')?.addEventListener('click', () => { show(current + 1); stop(); start(); });
    dots.forEach((d, k) => d.addEventListener('click', () => { show(k); stop(); start(); }));
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    start();
  });
</script>
