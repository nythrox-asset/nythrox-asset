---
import Flag from './Flag.astro';
import { languages } from '../i18n/ui';
import { toLang, useTranslations, localizePath } from '../i18n/utils';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const path = Astro.url.pathname;
const current = languages.find((l) => l.code === lang)!;
---

<details class="lang-switcher relative">
  <summary
    class="flex cursor-pointer list-none items-center gap-1.5 rounded-lg border border-border bg-surface px-2.5 py-2 text-text-muted transition-colors hover:text-text"
    aria-label={t('lang.label')}
    title={t('lang.label')}
  >
    <Flag code={current.flag} />
    <span class="text-xs font-semibold uppercase tracking-wide">{current.code}</span>
    <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
      <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </summary>

  <ul class="absolute right-0 z-50 mt-2 min-w-[172px] overflow-hidden rounded-xl border border-border bg-surface-2 p-1 shadow-2xl">
    {
      languages.map((l) => (
        <li>
          <a
            href={localizePath(path, l.code)}
            hreflang={l.code}
            class:list={[
              'flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm transition-colors',
              l.code === lang ? 'bg-accent/12 text-text' : 'text-text-muted hover:bg-surface hover:text-text',
            ]}
          >
            <Flag code={l.flag} />
            <span>{l.name}</span>
            {l.code === lang && (
              <svg viewBox="0 0 24 24" class="ml-auto h-4 w-4 text-accent-bright" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                <path d="m5 12 4.5 4.5L19 7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  details.lang-switcher > summary::-webkit-details-marker,
  details.lang-switcher > summary::marker {
    display: none;
    content: '';
  }
  details.lang-switcher[open] > summary svg:last-of-type {
    transform: rotate(180deg);
  }
</style>

<script>
  document.querySelectorAll<HTMLDetailsElement>('details.lang-switcher').forEach((d) => {
    document.addEventListener('click', (e) => {
      if (d.open && e.target instanceof Node && !d.contains(e.target)) d.open = false;
    });
    d.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') d.open = false;
    });
  });
</script>
