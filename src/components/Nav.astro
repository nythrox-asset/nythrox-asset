---
import { SITE } from '../site';
import { toLang, useTranslations, homeHref, localizePath } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const home = homeHref(lang);
const links = [
  { href: `${home}#assets`, label: t('nav.assets') },
  { href: `${home}#about`, label: t('nav.about') },
  // Documentation et support sont annonces sur les fiches Fab : ils doivent
  // etre atteignables depuis n'importe quelle page, pas seulement l'accueil.
  //
  // Docs MASQUEES du menu (decision Nathan 27/07/2026) : le seul manuel en
  // ligne est celui du Door System, retire de la boutique tant que le plugin
  // n'est pas publie. La page reste GENEREE et accessible par son URL directe
  // (/docs/interactive-door-system), pour un acheteur a qui on la donnerait,
  // mais elle n'est plus proposee a tous les visiteurs. Retirer le commentaire
  // le jour de la publication.
  // { href: localizePath('/docs/interactive-door-system', lang), label: t('nav.docs') },
  { href: localizePath('/support', lang), label: t('nav.support') },
];
---

<header class="sticky top-0 z-40 border-b border-border/70 bg-bg/80 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8">
    <a href={home} class="group flex items-center gap-2.5" aria-label="Nythrox">
      <img
        src="/branding/nythrox_logo_transparent.png"
        alt="Nythrox"
        width="34"
        height="34"
        class="h-8 w-8 transition-transform duration-300 group-hover:scale-105"
      />
      <span class="font-display text-lg font-bold tracking-tight text-text">Nythrox-Asset</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="hidden rounded-lg px-3 py-2 text-sm font-medium text-text-muted transition-colors hover:text-text sm:inline-block"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href={SITE.fabStoreUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-lg bg-accent px-3.5 py-2 text-sm font-semibold text-white transition-colors hover:bg-accent-deep"
      >
        {t('nav.fabStore')}
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <LanguageSwitcher />
    </div>
  </nav>
</header>
