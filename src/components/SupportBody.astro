---
/* ------------------------------------------------------------------ *
 *  Page de support, annoncee sur les fiches Fab.                       *
 *                                                                      *
 *  29/07/2026 : PAS de serveur Discord. On donne l'identifiant de       *
 *  Nathan, a qui veut discuter. Regle conservee : si le champ est vide, *
 *  on n'affiche PAS un contact mort.                                    *
 * ------------------------------------------------------------------ */
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
import { toLang } from '../i18n/utils';

// Meme motif que HomeBody : le composant deduit la langue, et chaque page
// localisee n'est qu'une enveloppe d'une ligne.
const lang = toLang(Astro.currentLocale);

const hasDiscord = Boolean(SITE.support.discordHandle);
const hasEmail = Boolean(SITE.support.email);

const copy = {
  en: {
    kicker: 'Support',
    title: 'Get help with your pack',
    lead:
      'Every Nythrox product is supported by a real person. Message me on Discord, describe what you are seeing, and you get an answer.',
    discordTitle: 'Discord, the fastest route',
    discordBody:
      'Add me and write directly: bug reports, integration questions, feature requests. No ticket queue, no bot, you get me.',
    discordCta: 'My Discord',
    discordSoon: 'Discord contact coming shortly.',
    emailTitle: 'Prefer email?',
    emailBody: 'For invoicing, licensing or anything you would rather not post publicly.',
    responseTitle: 'Response time',
    responseBody: `Typical first answer within ${SITE.support.responseTime}. Weekends included, but slower.`,
    beforeTitle: 'Before you post, this saves us both time',
    before: [
      'Your Unreal Engine version, and the exact pack or plugin version.',
      'What you did, what you expected, what happened instead.',
      'A screenshot of the viewport, and the Output Log if something failed.',
      'Whether the issue happens in a brand new empty project too.',
    ],
    scopeTitle: 'What support covers',
    scopeYes: [
      'Anything that does not work as described on the product page.',
      'Installation, migration into your own project, engine version questions.',
      'Bugs, crashes, missing references, broken collisions.',
    ],
    scopeNo: [
      'Custom development or paid feature work on request.',
      'Engine problems unrelated to the pack.',
      'Redistribution or licence transfers, handled by Fab.',
    ],
  },
  fr: {
    kicker: 'Support',
    title: 'De l’aide sur ton pack',
    lead:
      'Chaque produit Nythrox est suivi par une vraie personne. Écris-moi sur Discord, décris ce que tu vois, tu auras une réponse.',
    discordTitle: 'Discord, le chemin le plus rapide',
    discordBody:
      'Ajoute-moi et écris directement : bugs, questions d’intégration, demandes de fonctionnalités. Pas de file de tickets, pas de bot, tu m’as moi.',
    discordCta: 'Mon Discord',
    discordSoon: 'Contact Discord bientôt disponible.',
    emailTitle: 'Tu préfères l’e-mail ?',
    emailBody: 'Pour la facturation, la licence, ou tout ce que tu ne veux pas écrire en public.',
    responseTitle: 'Délai de réponse',
    responseBody: `Première réponse généralement sous ${SITE.support.responseTime}. Week-ends compris, mais plus lentement.`,
    beforeTitle: 'À joindre dès le premier message, ça fait gagner un aller-retour',
    before: [
      'Ta version d’Unreal Engine, et la version exacte du pack ou du plugin.',
      'Ce que tu as fait, ce que tu attendais, ce qui s’est passé à la place.',
      'Une capture du viewport, et l’Output Log si quelque chose a échoué.',
      'Si le problème apparaît aussi dans un projet vide tout neuf.',
    ],
    scopeTitle: 'Ce que couvre le support',
    scopeYes: [
      'Tout ce qui ne fonctionne pas comme annoncé sur la fiche produit.',
      'Installation, migration dans ton propre projet, questions de version moteur.',
      'Bugs, plantages, références manquantes, collisions cassées.',
    ],
    scopeNo: [
      'Le développement sur mesure, qui se traite en prestation.',
      'Les problèmes du moteur sans rapport avec le pack.',
      'La revente et les transferts de licence, gérés par Fab.',
    ],
  },
  es: {
    kicker: 'Soporte',
    title: 'Ayuda con tu pack',
    lead:
      'Cada producto Nythrox tiene detrás a una persona real. Escríbeme por Discord, describe lo que ves y tendrás respuesta.',
    discordTitle: 'Discord, la vía más rápida',
    discordBody:
      'Añádeme y escribe directamente: errores, preguntas de integración, peticiones de funciones. Sin cola de tickets, sin bot, hablas conmigo.',
    discordCta: 'Mi Discord',
    discordSoon: 'Contacto de Discord disponible en breve.',
    emailTitle: '¿Prefieres el correo?',
    emailBody: 'Para facturación, licencias o cualquier cosa que no quieras publicar.',
    responseTitle: 'Tiempo de respuesta',
    responseBody: `Primera respuesta normalmente en ${SITE.support.responseTime}. Fines de semana incluidos, pero más lentos.`,
    beforeTitle: 'Antes de escribir, esto ahorra una ida y vuelta',
    before: [
      'Tu versión de Unreal Engine y la versión exacta del pack o plugin.',
      'Qué hiciste, qué esperabas y qué ocurrió en su lugar.',
      'Una captura del viewport y el Output Log si algo falló.',
      'Si el problema aparece también en un proyecto vacío nuevo.',
    ],
    scopeTitle: 'Qué cubre el soporte',
    scopeYes: [
      'Todo lo que no funcione como se anuncia en la ficha del producto.',
      'Instalación, migración a tu proyecto, preguntas de versión del motor.',
      'Errores, cierres inesperados, referencias que faltan, colisiones rotas.',
    ],
    scopeNo: [
      'Desarrollo a medida, que se trata como encargo.',
      'Problemas del motor ajenos al pack.',
      'Reventa y transferencia de licencias, gestionadas por Fab.',
    ],
  },
} as const;

const c = copy[lang] ?? copy.en;
---

<Base title={c.title} description={c.lead}>
  <section class="mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-24">
  <p class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-accent">
    {c.kicker}
  </p>
  <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-text sm:text-5xl">
    {c.title}
  </h1>
  <p class="mt-5 text-lg leading-relaxed text-text-muted">{c.lead}</p>

  <!-- Discord -->
  <div class="mt-12 rounded-2xl border border-border/70 bg-surface/60 p-6 sm:p-8">
    <h2 class="font-display text-xl font-bold text-text">{c.discordTitle}</h2>
    <p class="mt-2.5 leading-relaxed text-text-muted">{c.discordBody}</p>
    {
      hasDiscord ? (
        /*
         * Un identifiant Discord n'est PAS une adresse cliquable : le lien
         * discord.com/users/<id> exige l'identifiant NUMERIQUE, pas le nom
         * d'utilisateur. On affiche donc le nom tel quel, a copier, plutot
         * qu'un lien qui tomberait dans le vide.
         */
        <p class="mt-5 inline-flex items-center gap-2 rounded-lg bg-accent px-4 py-2.5 text-sm font-semibold text-white">
          <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="currentColor" aria-hidden="true">
            <path d="M20.317 4.3698a19.7913 19.7913 0 0 0-4.8851-1.5152.0741.0741 0 0 0-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 0 0-.0785-.037 19.7363 19.7363 0 0 0-4.8852 1.515.0699.0699 0 0 0-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 0 0 .0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 0 0 .0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 0 0-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 0 1-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 0 1 .0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 0 1 .0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 0 1-.0066.1276 12.2986 12.2986 0 0 1-1.873.8914.0766.0766 0 0 0-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 0 0 .0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 0 0 .0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 0 0-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z" />
          </svg>
          <span class="sr-only">{c.discordCta}</span>
          <code class="font-mono tracking-tight">{SITE.support.discordHandle}</code>
        </p>
      ) : (
        <p class="mt-5 inline-flex items-center gap-2 rounded-lg border border-dashed border-border px-4 py-2.5 text-sm font-medium text-text-muted">
          {c.discordSoon}
        </p>
      )
    }
  </div>

  <!-- E-mail + delai -->
  <div class="mt-6 grid gap-6 sm:grid-cols-2">
    {
      hasEmail && (
        <div class="rounded-2xl border border-border/70 bg-surface/40 p-6">
          <h2 class="font-display text-lg font-bold text-text">{c.emailTitle}</h2>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">{c.emailBody}</p>
          <a
            href={`mailto:${SITE.support.email}`}
            class="mt-3 inline-block text-sm font-semibold text-accent hover:underline"
          >
            {SITE.support.email}
          </a>
        </div>
      )
    }
    <div class="rounded-2xl border border-border/70 bg-surface/40 p-6">
      <h2 class="font-display text-lg font-bold text-text">{c.responseTitle}</h2>
      <p class="mt-2 text-sm leading-relaxed text-text-muted">{c.responseBody}</p>
    </div>
  </div>

  <!-- Checklist -->
  <div class="mt-12">
    <h2 class="font-display text-xl font-bold text-text">{c.beforeTitle}</h2>
    <ul class="mt-4 space-y-2.5">
      {
        c.before.map((item) => (
          <li class="flex gap-3 text-text-muted">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
            <span class="leading-relaxed">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Perimetre -->
  <div class="mt-12">
    <h2 class="font-display text-xl font-bold text-text">{c.scopeTitle}</h2>
    <div class="mt-4 grid gap-6 sm:grid-cols-2">
      <ul class="space-y-2.5">
        {
          c.scopeYes.map((item) => (
            <li class="flex gap-3 text-text-muted">
              <svg viewBox="0 0 24 24" class="mt-1 h-4 w-4 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="text-sm leading-relaxed">{item}</span>
            </li>
          ))
        }
      </ul>
      <ul class="space-y-2.5">
        {
          c.scopeNo.map((item) => (
            <li class="flex gap-3 text-text-muted/70">
              <svg viewBox="0 0 24 24" class="mt-1 h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round" />
              </svg>
              <span class="text-sm leading-relaxed">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  </section>
</Base>
