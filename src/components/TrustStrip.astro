---
import { toLang, useTranslations } from '../i18n/utils';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

const items = ['ready', 'source', 'organized', 'collision'] as const;
---

<ul class="mt-2.5 flex flex-wrap items-center gap-x-2.5 gap-y-1.5 text-[13px] text-text-faint">
  {
    items.map((key, i) => (
      <>
        {i > 0 && <li aria-hidden="true" class="select-none text-text-faint/60">·</li>}
        <li>
          <span class="text-text-muted">{t(`trust.${key}.title` as any)}</span>
          <span class="hidden sm:inline"> — {t(`trust.${key}.desc` as any)}</span>
        </li>
      </>
    ))
  }
</ul>
