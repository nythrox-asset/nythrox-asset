---
/**
 * Vidéo YouTube à chargement léger (façade) : on n'insère l'iframe
 * qu'au clic, donc zéro script YouTube tant que l'utilisateur ne lance pas.
 * Accepte un ID (« dQw4w9WgXcQ ») ou n'importe quelle URL YouTube.
 */
import { toLang, useTranslations } from '../i18n/utils';

interface Props {
  youtube: string;
  title?: string;
}
const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const { youtube, title = t('video.title') } = Astro.props;

function parseId(input: string): string {
  const s = input.trim();
  // ID brut (11 caractères)
  if (/^[a-zA-Z0-9_-]{11}$/.test(s)) return s;
  try {
    const u = new URL(s);
    if (u.hostname.includes('youtu.be')) return u.pathname.slice(1);
    if (u.searchParams.get('v')) return u.searchParams.get('v')!;
    const parts = u.pathname.split('/');
    const i = parts.findIndex((p) => p === 'embed' || p === 'shorts');
    if (i !== -1 && parts[i + 1]) return parts[i + 1];
  } catch {
    /* pas une URL */
  }
  return s;
}
const id = parseId(youtube);
const thumb = `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`;
---

<div
  class="group relative aspect-video overflow-hidden rounded-[--radius-card] border border-border bg-surface-2"
  data-video-facade
  data-video-id={id}
>
  <button
    type="button"
    class="absolute inset-0 flex h-full w-full cursor-pointer items-center justify-center"
    aria-label={t('video.play', { title })}
  >
    <img
      src={thumb}
      alt=""
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover opacity-80 transition-opacity duration-300 group-hover:opacity-100"
      onerror="this.onerror=null;this.src=`https://i.ytimg.com/vi/${this.parentElement.parentElement.dataset.videoId}/hqdefault.jpg`"
    />
    <span
      class="relative flex h-16 w-16 items-center justify-center rounded-full bg-accent/90 shadow-lg transition-transform duration-300 group-hover:scale-110 accent-glow"
    >
      <svg viewBox="0 0 24 24" class="ml-0.5 h-7 w-7 text-white" fill="currentColor" aria-hidden="true">
        <path d="M8 5v14l11-7z" />
      </svg>
    </span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-video-facade]').forEach((el) => {
    const btn = el.querySelector('button');
    btn?.addEventListener('click', () => {
      const id = el.dataset.videoId;
      const iframe = document.createElement('iframe');
      iframe.width = '100%';
      iframe.height = '100%';
      iframe.className = 'absolute inset-0 h-full w-full';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.title = 'YouTube video player';
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      el.replaceChildren(iframe);
    });
  });
</script>
