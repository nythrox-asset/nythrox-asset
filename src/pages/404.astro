---
import Base from '../layouts/Base.astro';
import CubeMark from '../components/CubeMark.astro';
import { toLang, useTranslations, homeHref } from '../i18n/utils';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<Base title="404">
  <section class="mx-auto flex max-w-2xl flex-col items-center px-5 py-32 text-center">
    <CubeMark class="h-20 w-20 opacity-70" float={true} />
    <h1 class="mt-8 font-display text-6xl font-bold text-text">404</h1>
    <p class="mt-3 text-text-muted">{t('notfound.subtitle')}</p>
    <a
      href={homeHref(lang)}
      class="mt-8 inline-flex items-center gap-2 rounded-xl bg-accent px-6 py-3.5 font-semibold text-white transition-colors hover:bg-accent-deep"
    >
      {t('notfound.back')}
    </a>
  </section>
</Base>
